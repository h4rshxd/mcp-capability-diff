{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["version", "server", "default_action"],
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "integer",
      "enum": [1]
    },
    "server": {
      "type": "string",
      "minLength": 1
    },
    "default_action": {
      "type": "string",
      "enum": ["allow", "block"]
    },
    "allowed_capabilities": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tools": {
          "type": "array",
          "items": { "type": "string" }
        },
        "resources": {
          "type": "array",
          "items": { "type": "string" }
        },
        "resourceTemplates": {
          "type": "array",
          "items": { "type": "string" }
        },
        "prompts": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    }
  }
}
